<UserControl x:Class="Taxiturne.View.RepartiteurView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Taxiturne.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
               Text="Courses"
               FontSize="18"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"/>
        <TextBlock Grid.Row="0" Grid.Column="1"
               Text="Chauffeurs"
               FontSize="18"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"/>

        <ListView Grid.Row="1" Grid.Column="0"
              Margin="0,15,0,0"
              ItemsSource="{Binding Courses}"
              SelectedItem="{Binding SelectedCourse}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,5,0,5" CornerRadius="6" Background="#F3F4F6">
                        <StackPanel>
                            <TextBlock Text="{Binding Client.Nom, StringFormat='Client: {0}'}" FontSize="13"/>
                            <TextBlock Text="{Binding AdresseDestination, StringFormat='Destination: {0}'}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding DateHeurePriseEnCharge, StringFormat='Date de prise en charge: {0}'}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding CategorieDemandee.Nom, StringFormat='Catégorie demandée: {0}'}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding NombrePassagers, StringFormat='Nombre de passagers: {0}'}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding NombreBagages, StringFormat='Nombre de bagages: {0}'}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding AnimalABord, Converter={StaticResource BoolToTextConverter}, StringFormat='Animal à bord: {0}'}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding FauteuilRoulant, Converter={StaticResource BoolToTextConverter}, StringFormat='Fauteuil roulant requis: {0}'}" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding SiegeEnfantRequis, Converter={StaticResource BoolToTextConverter}, StringFormat='Siège pour enfant requis: {0}'}" FontSize="13" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView Grid.Row="1" Grid.Column="1"
              Margin="0,15,0,0"
              ItemsSource="{Binding Chauffeurs}"
              SelectedItem="{Binding SelectedChauffer}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,5,0,5" CornerRadius="6" Background="#F3F4F6">
                        <StackPanel>
                            <TextBlock Text="{Binding Nom, StringFormat='Nom: {0}'}" FontSize="13"/>
                            <TextBlock Text="{Binding Vehicule.Categorie.Nom, StringFormat='Voiture: {0}'}" FontSize="13" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" Grid.Column="0"
               Text="{Binding MessageErreur}"
               Foreground="Red"
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               FontWeight="Bold"
               Margin="10,0"/>

        <Button Grid.Row="2" Grid.Column="1"
            Content="Attribuer"
            Foreground="White"
            Background="#2563EB"
            BorderThickness="0"
            FontWeight="SemiBold"
            Cursor="Hand"
            Command="{Binding AttribuerCommand}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Padding="20,6"
            Margin="0,10,10,10">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>
